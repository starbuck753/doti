{
  "name": "doti",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/copy-404.mjs",
    "build:android": "tsc -b && vite build --mode android",
    "android:sync": "npm run build:android && cap sync android",
    "android:open": "cap open android",
    "android:debug": "npm run android:sync && node scripts/build-android.mjs",
    "test:habits": "node --experimental-strip-types --test tests/habits.test.ts",
    "preview": "vite preview"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/core": "^8.5.3",
    "@capacitor/filesystem": "^8.1.4",
    "@capacitor/share": "^8.0.3",
    "@capacitor/status-bar": "^8.0.4",
    "@supabase/supabase-js": "^2.117.2",
    "@vitejs/plugin-react": "latest",
    "dexie": "latest",
    "i18next": "latest",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "react-i18next": "latest",
    "react-router-dom": "latest"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "typescript": "latest",
    "vite": "latest",
    "vite-plugin-pwa": "^1.3.0"
  }
}
